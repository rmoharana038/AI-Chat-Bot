# Google Gemini AI Settings
# Get free API key: https://aistudio.google.com/
VITE_GEMINI_API_KEY=AIzaSy...your_gemini_key_here
GEMINI_API_KEY=AIzaSy...your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Facebook Messenger Platform (Meta Graph API) Settings
# Set these in Netlify Environment Variables for 24/7 always-active Messenger bot!
# Get Page Access Token from: https://developers.facebook.com/
FB_PAGE_ACCESS_TOKEN=EAAG...your_facebook_page_access_token_here
FB_VERIFY_TOKEN=my_secure_fb_webhook_verify_token_12345
